{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint . && vue-tsc --noEmit",
        "eslint:fix": "eslint --config eslint.config.js src --fix",
        "eslint:check": "eslint --config eslint.config.js",
        "eslint:check:no-warn": "eslint --config eslint.config.js --no-warn-ignored",
        "eslint:check:exit-on-fail": "eslint --exit-on-fatal-error",
        "try:open-on-editor": "curl \"http://host.docker.internal:3001/__open-in-editor?file=/app/src/main.ts:1:1\"",
        "try:open-on-editor2": "curl \"http://172.17.0.1:3001/__open-in-editor?file=/app/src/main.ts:1:1\"",
        "dev:open-in-editor-server": "node open-in-editor-server.js",
        "open-in-editor-server": "node open-in-editor-server.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/material-symbols": "^1.2.53",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/tabler": "^1.2.26",
        "@iconify/vue": "^5.0.0",
        "@tailwindcss/vite": "^4.1.18",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^24.10.13",
        "@types/serialize-javascript": "^5.0.4",
        "@types/turndown": "^5.0.6",
        "@typescript-eslint/eslint-plugin": "^8.59.0",
        "@typescript-eslint/parser": "^8.59.0",
        "@vercel/speed-insights": "^2.0.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.8.1",
        "dotenv": "^17.2.3",
        "dotenv-expand": "^12.0.3",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-vue": "^10.8.0",
        "globals": "^17.4.0",
        "markdown-it": "^14.1.0",
        "md-editor-v3": "^6.3.1",
        "pinia": "^3.0.4",
        "prettier": "^3.8.1",
        "radash": "^12.1.1",
        "serialize-javascript": "^7.0.4",
        "sprintf-js": "^1.1.3",
        "tailwindcss": "^4.1.18",
        "toastify-js": "^1.12.0",
        "turndown": "^7.2.2",
        "typescript": "~5.9.3",
        "undici": "^7.22.0",
        "undici-types": "^7.22.0",
        "vite": "^7.2.4",
        "vite-plugin-vue-devtools": "^8.1.1",
        "vue": "^3.5.27",
        "vue-eslint-parser": "^10.4.0",
        "vue-router": "^4.6.4",
        "vue-tsc": "^3.1.4",
        "vue3-toastify": "^0.2.8",
        "zod": "^3.25.76"
    },
    "dependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "laravel-precognition": "^2.0.0",
        "laravel-precognition-vue": "^2.0.0"
    }
}
